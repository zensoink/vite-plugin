{
  "name": "@zenso/zenso-vite-plugin",
  "version": "0.1.0",
  "description": "Vite plugin for Zenso e-ink plugins: Liquid dev render, manifest/build emit, plugin.zip pack",
  "license": "MIT",
  "author": {
    "name": "zenso.ink",
    "url": "https://zenso.ink"
  },
  "homepage": "https://github.com/zensoink/zenso-vite-plugin",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zensoink/zenso-vite-plugin.git"
  },
  "bugs": {
    "url": "https://github.com/zensoink/zenso-vite-plugin/issues"
  },
  "keywords": [
    "vite",
    "vite-plugin",
    "liquid",
    "zenso",
    "e-ink"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "vite": "^6 || ^7"
  },
  "dependencies": {
    "liquidjs": "^10.10.0",
    "vite-plugin-zip-pack": "^1.2.3"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "typescript": "^5.5.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
